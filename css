/* =====================================================
   TEKNOAI - STYLE PRINCIPAL
   ===================================================== */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #080b12;
    color: #ffffff;
    min-height: 100vh;
}


/* ================= VARIABLES ================= */

:root {
    --background: #080b12;
    --surface: #10151f;
    --surface-light: #151c28;
    --border: #252e3d;

    --primary: #ff2d8d;
    --primary-dark: #d91d72;

    --text: #ffffff;
    --text-light: #aeb7c5;
}


/* ================= HEADER ================= */

.header {
    width: 100%;
    height: 76px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 6%;

    background: rgba(8, 11, 18, 0.92);

    border-bottom: 1px solid var(--border);

    position: sticky;
    top: 0;
    z-index: 100;
}


/* ================= LOGO ================= */

.logo {
    display: flex;
    align-items: center;
    gap: 10px;

    font-size: 22px;
    font-weight: 800;
}

.logo > span > span {
    color: var(--primary);
}

.logo-icon {
    width: 38px;
    height: 38px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--primary);

    color: white;

    border-radius: 10px;

    font-size: 21px;
    font-weight: 900;

    box-shadow: 0 0 25px rgba(255, 45, 141, 0.25);
}


/* ================= NAVIGATION ================= */

.navigation {
    display: flex;
    align-items: center;
    gap: 8px;
}

.nav-button {
    background: transparent;
    color: var(--text-light);

    border: none;

    padding: 10px 15px;

    border-radius: 8px;

    cursor: pointer;

    font-size: 14px;

    transition: 0.25s;
}

.nav-button:hover {
    color: white;
    background: var(--surface-light);
}

.nav-button.active {
    color: white;
    background: var(--surface-light);
}


/* ================= MENU MOBILE ================= */

.menu-button {
    display: none;

    border: 1px solid var(--border);

    background: var(--surface);

    color: white;

    border-radius: 8px;

    padding: 9px 12px;

    font-size: 18px;

    cursor: pointer;
}


/* ================= MAIN ================= */

.main-container {
    width: 88%;
    max-width: 1200px;

    margin: auto;

    min-height: 700px;
}


/* ================= SECTIONS ================= */

.section {
    display: none;

    padding: 80px 0;
}

.section.active-section {
    display: block;
}


/* ================= HERO ================= */

.hero {
    text-align: center;

    max-width: 850px;

    margin: 0 auto 80px;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;

    padding: 8px 14px;

    background: rgba(255, 45, 141, 0.08);

    border: 1px solid rgba(255, 45, 141, 0.25);

    border-radius: 50px;

    color: #ff72b0;

    font-size: 13px;

    margin-bottom: 25px;
}

.status-dot {
    width: 8px;
    height: 8px;

    background: #35df8a;

    border-radius: 50%;
}

.hero h1 {
    font-size: clamp(40px, 6vw, 72px);

    line-height: 1.05;

    letter-spacing: -2px;

    margin-bottom: 25px;
}

.hero h1 span {
    color: var(--primary);
}

.hero-text {
    max-width: 700px;

    margin: auto;

    color: var(--text-light);

    font-size: 17px;

    line-height: 1.8;
}


/* ================= BUTTONS ================= */

.hero-actions {
    display: flex;

    justify-content: center;

    gap: 12px;

    margin-top: 35px;
}

.primary-button,
.secondary-button {
    border: none;

    padding: 13px 20px;

    border-radius: 9px;

    cursor: pointer;

    font-weight: 700;

    transition: 0.25s;
}

.primary-button {
    background: var(--primary);

    color: white;
}

.primary-button:hover {
    background: var(--primary-dark);

    transform: translateY(-2px);
}

.secondary-button {
    background: var(--surface);

    color: white;

    border: 1px solid var(--border);
}

.secondary-button:hover {
    background: var(--surface-light);
}


/* ================= CARDS ================= */

.cards-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 18px;
}

.feature-card {
    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 15px;

    padding: 25px;

    transition: 0.3s;
}

.feature-card:hover {
    transform: translateY(-6px);

    border-color: rgba(255, 45, 141, 0.45);

    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
}

.card-icon {
    font-size: 30px;

    margin-bottom: 20px;
}

.feature-card h3 {
    margin-bottom: 10px;
}

.feature-card p {
    color: var(--text-light);

    line-height: 1.6;

    font-size: 14px;

    min-height: 90px;
}

.card-button {
    background: transparent;

    color: var(--primary);

    border: none;

    cursor: pointer;

    font-weight: 700;

    padding: 0;

    margin-top: 15px;
}


/* ================= PAGE HEADER ================= */

.page-header {
    display: flex;

    align-items: center;

    gap: 18px;

    margin-bottom: 40px;
}

.page-icon {
    width: 55px;
    height: 55px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: rgba(255, 45, 141, 0.1);

    border: 1px solid rgba(255, 45, 141, 0.2);

    border-radius: 14px;

    font-size: 25px;
}

.page-header h2 {
    font-size: 30px;

    margin-bottom: 5px;
}

.page-header p {
    color: var(--text-light);
}


/* ================= LEARNING ================= */

.learning-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 18px;
}

.learning-card {
    display: flex;

    align-items: center;

    gap: 18px;

    text-align: left;

    padding: 22px;

    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 13px;

    color: white;

    cursor: pointer;

    transition: 0.25s;
}

.learning-card:hover {
    transform: translateY(-4px);

    border-color: var(--primary);
}

.learning-card > span {
    font-size: 30px;
}

.learning-card p {
    color: var(--text-light);

    margin-top: 5px;

    font-size: 13px;
}


/* ================= PROJECTS ================= */

.project-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 20px;
}

.project-card {
    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 15px;

    padding: 30px;
}

.project-number {
    color: var(--primary);

    font-size: 14px;

    font-weight: bold;

    margin-bottom: 20px;
}

.project-card p {
    color: var(--text-light);

    line-height: 1.7;

    margin: 15px 0 25px;
}

.project-button {
    background: var(--primary);

    border: none;

    color: white;

    padding: 10px 15px;

    border-radius: 8px;

    cursor: pointer;
}


/* ================= SEARCH ================= */

.search-box {
    display: flex;

    gap: 10px;

    margin-bottom: 30px;
}

.search-box input {
    flex: 1;

    background: var(--surface);

    border: 1px solid var(--border);

    color: white;

    padding: 15px;

    border-radius: 9px;

    outline: none;
}

.search-box input:focus {
    border-color: var(--primary);
}

.search-box button {
    background: var(--primary);

    color: white;

    border: none;

    border-radius: 9px;

    padding: 0 25px;

    cursor: pointer;

    font-weight: bold;
}

.empty-result {
    text-align: center;

    padding: 70px 20px;

    color: var(--text-light);
}

.empty-result span {
    display: block;

    font-size: 40px;

    margin-bottom: 15px;
}


/* ================= CONTENT ================= */

.content-box {
    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 15px;

    padding: 35px;
}

.content-box h3 {
    margin-bottom: 15px;
}

.content-box > p {
    color: var(--text-light);

    line-height: 1.8;

    max-width: 850px;
}

.info-grid {
    display: grid;

    grid-template-columns: repeat(4, 1fr);

    gap: 15px;

    margin-top: 35px;
}

.info-grid div {
    padding: 20px;

    background: var(--surface-light);

    border-radius: 10px;
}

.info-grid strong {
    display: block;

    color: var(--primary);

    margin-bottom: 8px;
}

.info-grid span {
    color: var(--text-light);
}


/* ================= STEPS ================= */

.steps {
    display: grid;

    gap: 15px;
}

.step {
    display: flex;

    align-items: center;

    gap: 20px;

    padding: 22px;

    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 12px;
}

.step > span {
    min-width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: var(--primary);

    border-radius: 50%;

    font-weight: bold;
}

.step p {
    color: var(--text-light);

    margin-top: 5px;
}


/* ================= IDEAS ================= */

.ideas-list {
    display: grid;

    grid-template-columns: repeat(2, 1fr);

    gap: 18px;
}

.idea {
    display: flex;

    gap: 18px;

    background: var(--surface);

    border: 1px solid var(--border);

    padding: 25px;

    border-radius: 13px;
}

.idea > span {
    font-size: 30px;
}

.idea p {
    color: var(--text-light);

    margin-top: 6px;
}


/* ================= MODAL ================= */

.modal {
    position: fixed;

    inset: 0;

    display: none;

    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(0, 0, 0, 0.75);

    z-index: 500;
}

.modal.show {
    display: flex;
}

.modal-content {
    position: relative;

    width: 100%;

    max-width: 500px;

    background: var(--surface);

    border: 1px solid var(--border);

    border-radius: 18px;

    padding: 35px;

    text-align: center;
}

.close-modal {
    position: absolute;

    right: 18px;
    top: 15px;

    background: transparent;

    border: none;

    color: var(--text-light);

    font-size: 25px;

    cursor: pointer;
}

.modal-icon {
    font-size: 45px;

    margin-bottom: 15px;
}

.modal-content p {
    color: var(--text-light);

    line-height: 1.7;

    margin: 15px 0 25px;
}


/* ================= FOOTER ================= */

.footer {
    border-top: 1px solid var(--border);

    padding: 35px 6%;

    text-align: center;

    color: var(--text-light);
}

.footer .logo {
    justify-content: center;

    margin-bottom: 15px;
}

.copyright {
    margin-top: 15px;

    font-size: 12px;
}


/* ================= RESPONSIVE ================= */

@media (max-width: 950px) {

    .cards-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .learning-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    .info-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}


@media (max-width: 700px) {

    .header {
        padding: 0 5%;
    }

    .navigation {
        display: none;

        position: absolute;

        top: 76px;
        left: 0;

        width: 100%;

        background: var(--surface);

        border-bottom: 1px solid var(--border);

        padding: 15px;

        flex-direction: column;
    }

    .navigation.show {
        display: flex;
    }

    .nav-button {
        width: 100%;

        text-align: left;
    }

    .menu-button {
        display: block;
    }

    .cards-grid,
    .learning-grid,
    .ideas-list {
        grid-template-columns: 1fr;
    }

    .hero {
        margin-bottom: 50px;
    }

    .hero h1 {
        font-size: 42px;
    }

    .hero-actions {
        flex-direction: column;
    }

    .search-box {
        flex-direction: column;
    }

    .search-box button {
        padding: 14px;
    }

    .info-grid {
        grid-template-columns: 1fr;
    }

    .content-box {
        padding: 25px;
    }
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0b1020;
    color: #ffffff;
}

button,
textarea {
    font-family: inherit;
}

button {
    cursor: pointer;
}

.app {
    display: flex;
    min-height: 100vh;
}


/* ================= SIDEBAR ================= */

.sidebar {
    width: 270px;
    background: #111827;
    border-right: 1px solid #263044;
    padding: 22px 15px;
    display: flex;
    flex-direction: column;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px;
    margin-bottom: 25px;
}

.logo-icon {
    width: 43px;
    height: 43px;
    border-radius: 13px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: linear-gradient(135deg, #6366f1, #8b5cf6);

    font-size: 22px;
    font-weight: bold;
}

.logo strong {
    display: block;
    font-size: 19px;
}

.logo small {
    display: block;
    color: #94a3b8;
    margin-top: 3px;
}

.new-chat {
    width: 100%;
    border: 0;
    border-radius: 12px;
    padding: 13px;
    background: #4f46e5;
    color: white;
    font-weight: bold;
    margin-bottom: 20px;
}

.new-chat:hover {
    background: #6366f1;
}

.menu {
    width: 100%;
    display: flex;
    align-items: center;
    gap: 13px;

    padding: 12px;
    margin: 4px 0;

    border: 0;
    border-radius: 10px;

    background: transparent;
    color: #cbd5e1;

    text-align: left;
    font-size: 14px;
}

.menu:hover {
    background: #1e293b;
    color: white;
}

.menu.active {
    background: #252f48;
    color: white;
}

.sidebar-bottom {
    margin-top: auto;
}


/* ================= MAIN ================= */

.main {
    flex: 1;
    min-width: 0;
    position: relative;
}

.topbar {
    height: 65px;
    border-bottom: 1px solid #263044;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 0 30px;
    background: #0f172a;
}

.status {
    color: #94a3b8;
    font-size: 13px;
}

.online {
    width: 8px;
    height: 8px;
    background: #22c55e;
    display: inline-block;
    border-radius: 50%;
    margin-right: 7px;
}

.mobile-logo {
    display: none;
}


/* ================= HOME ================= */

.content {
    max-width: 1100px;
    margin: auto;
    padding: 65px 30px;
}

.hero {
    text-align: center;
    max-width: 750px;
    margin: auto;
}

.hero-icon {
    width: 75px;
    height: 75px;
    margin: auto;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #1e293b;
    border-radius: 22px;

    font-size: 38px;

    box-shadow: 0 0 40px rgba(99,102,241,.15);
}

.hero h1 {
    font-size: 40px;
    margin-top: 25px;
}

.hero h1 span {
    color: #818cf8;
}

.hero p {
    color: #94a3b8;
    line-height: 1.7;
    margin-top: 15px;
}


.cards {
    margin-top: 50px;

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
}

.card {
    text-align: left;

    background: #111827;
    border: 1px solid #263044;
    border-radius: 17px;

    padding: 23px;

    color: white;

    transition: .2s;
}

.card:hover {
    transform: translateY(-4px);
    border-color: #6366f1;
    background: #151e32;
}

.card-icon {
    width: 45px;
    height: 45px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    font-size: 22px;

    margin-bottom: 16px;
}

.blue { background: #172554; }
.purple { background: #2e1065; }
.yellow { background: #422006; }
.green { background: #052e16; }
.orange { background: #431407; }
.red { background: #450a0a; }

.card h3 {
    font-size: 17px;
}

.card p {
    color: #94a3b8;
    font-size: 13px;
    line-height: 1.6;
    margin-top: 8px;
}


/* ================= CHAT ================= */

.chat-section {
    max-width: 950px;
    margin: auto;
    padding: 35px 25px;
    min-height: calc(100vh - 65px);

    display: flex;
    flex-direction: column;
}

.chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    border-bottom: 1px solid #263044;
    padding-bottom: 20px;
}

.chat-header h2 {
    font-size: 22px;
}

.chat-header p {
    color: #94a3b8;
    font-size: 13px;
    margin-top: 5px;
}

.clear-btn {
    border: 1px solid #334155;
    background: transparent;
    color: #cbd5e1;
    padding: 9px 13px;
    border-radius: 9px;
}

.clear-btn:hover {
    background: #1e293b;
}

.messages {
    flex: 1;
    overflow-y: auto;
    padding: 30px 5px;
}

.message {
    display: flex;
    gap: 12px;
    margin-bottom: 25px;
    max-width: 850px;
}

.message.user {
    margin-left: auto;
    flex-direction: row-reverse;
}

.avatar {
    min-width: 38px;
    height: 38px;

    border-radius: 11px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #4f46e5;

    font-weight: bold;
}

.user .avatar {
    background: #334155;
}

.bubble {
    background: #172033;
    border: 1px solid #293449;
    border-radius: 14px;
    padding: 13px 16px;
    line-height: 1.7;
}

.user .bubble {
    background: #312e81;
}

.bubble strong {
    font-size: 13px;
}

.bubble p {
    margin-top: 4px;
    white-space: pre-wrap;
}


/* ================= SUGGESTIONS ================= */

.suggestions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
}

.suggestion {
    border: 1px solid #334155;
    background: #111827;
    color: #cbd5e1;
    padding: 8px 12px;
    border-radius: 20px;
    font-size: 12px;
}

.suggestion:hover {
    border-color: #6366f1;
    color: white;
}


/* ================= INPUT ================= */

.input-area {
    display: flex;
    gap: 10px;

    background: #111827;
    border: 1px solid #334155;

    padding: 10px;

    border-radius: 15px;
}

textarea {
    flex: 1;

    resize: none;

    border: 0;
    outline: 0;

    background: transparent;
    color: white;

    padding: 8px;

    font-size: 14px;

    max-height: 150px;
}

textarea::placeholder {
    color: #64748b;
}

.send-btn {
    width: 45px;
    height: 45px;

    border: 0;
    border-radius: 12px;

    background: #4f46e5;
    color: white;

    font-size: 20px;
}

.send-btn:hover {
    background: #6366f1;
}

.send-btn:disabled {
    opacity: .5;
}

.input-info {
    text-align: center;
    color: #64748b;
    font-size: 10px;
    margin-top: 8px;
}


/* ================= MODAL ================= */

.modal {
    position: fixed;
    inset: 0;

    background: rgba(0,0,0,.7);

    display: flex;
    align-items: center;
    justify-content: center;

    z-index: 100;
}

.modal-box {
    width: min(450px, 90%);
    background: #111827;
    border: 1px solid #334155;
    border-radius: 20px;
    padding: 35px;
    text-align: center;
    position: relative;
}

.big-logo {
    width: 70px;
    height: 70px;

    margin: auto;

    display: flex;
    align-items: center;
    justify-content: center;

    background: linear-gradient(135deg, #6366f1, #8b5cf6);

    border-radius: 20px;

    font-size: 30px;
    font-weight: bold;
}

.modal-box h2 {
    margin-top: 15px;
}

.modal-box p {
    color: #94a3b8;
    line-height: 1.7;
    margin-top: 10px;
}

.version {
    font-size: 12px;
}

.close {
    position: absolute;
    right: 15px;
    top: 12px;

    border: 0;
    background: transparent;
    color: white;

    font-size: 25px;
}


/* ================= UTILS ================= */

.hidden {
    display: none !important;
}


/* ================= MOBILE ================= */

@media (max-width: 800px) {

    .sidebar {
        width: 70px;
        padding: 15px 10px;
    }

    .logo strong,
    .logo small,
    .new-chat,
    .menu span {
        display: none;
    }

    .logo {
        justify-content: center;
    }

    .menu {
        justify-content: center;
        font-size: 20px;
    }

    .new-chat {
        font-size: 20px;
    }

    .cards {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 30px;
    }

    .content {
        padding: 40px 18px;
    }

    .topbar {
        padding: 0 15px;
    }

    .chat-section {
        padding: 20px 12px;
    }

    .chat-header {
        gap: 10px;
    }

    .chat-header h2 {
        font-size: 17px;
    }

    .clear-btn {
        font-size: 11px;
    }
}
